# Factory runtime state: one folder per job, written while jobs run
/factory/jobs/*
!/factory/jobs/.gitkeep

.DS_Store

# Python bytecode from the factory script tests
__pycache__/

# Working files from making the pitch video (frames, browser profile, raw audio)
brag-output/
pitch/source/chrome-profile/
pitch/source/frames/

# Private marketing briefs, campaign drafts, customer evidence and results
/marketing/businesses/*
!/marketing/businesses/.gitkeep

# Local secrets; review staged content and history before publishing
.env
.env.*
!.env.example
!.env.sample
credentials.json
*.pem
*.key
